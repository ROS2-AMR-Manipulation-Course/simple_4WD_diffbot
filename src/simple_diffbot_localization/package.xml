<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simple_diffbot_localization</name>
  <version>0.0.0</version>
  <description>EKF odometry fusion and AMCL localization for simple_diffbot</description>
  <maintainer email="yinchheanyun21@gmail.com">yunboyloy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_amcl</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>robot_localization</depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>simple_diffbot_slam</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
