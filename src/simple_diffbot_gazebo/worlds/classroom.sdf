<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="classroom_world">

    <!-- Physics: 1 ms step, real-time -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <!-- Gazebo Harmonic systems. Sensors (LiDAR, camera) and Imu are required by simple_diffbot. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Lighting: sun with shadows plus a soft indoor light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>
    <light type="point" name="ceiling_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 2.3 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>15</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.0</quadratic></attenuation>
    </light>

    <!-- Ground: 30 x 30 m so it extends past the walls -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= WALLS (room interior x:-5..5, y:-4..4) ================= -->
    <!-- Static wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.075 1.25 0 0 0</pose>
      <link name="link">
        <collision name="body_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>10.3 0.15 2.5</size></box></geometry></collision>
        <visual name="body_vis"><pose>0 0 0 0 0 0</pose><geometry><box><size>10.3 0.15 2.5</size></box></geometry><material><ambient>0.92 0.92 0.88 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Static wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.075 1.25 0 0 0</pose>
      <link name="link">
        <collision name="body_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>10.3 0.15 2.5</size></box></geometry></collision>
        <visual name="body_vis"><pose>0 0 0 0 0 0</pose><geometry><box><size>10.3 0.15 2.5</size></box></geometry><material><ambient>0.92 0.92 0.88 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Static wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>5.075 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="body_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.15 8.0 2.5</size></box></geometry></collision>
        <visual name="body_vis"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.15 8.0 2.5</size></box></geometry><material><ambient>0.92 0.92 0.88 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Static wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5.075 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="body_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.15 8.0 2.5</size></box></geometry></collision>
        <visual name="body_vis"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.15 8.0 2.5</size></box></geometry><material><ambient>0.92 0.92 0.88 1</ambient><diffuse>0.92 0.92 0.88 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= STUDENT DESKS & CHAIRS =================
         Two columns (x=-3 and x=+3), three rows (y=-2.4, 0, 2.4).
         Central aisle |x|<1.8 m is clear; corridors beside walls are >=1.3 m. -->
    <!-- Student desk 1.2 x 0.6 m, top at 0.75 m -->
    <model name="desk_left_1">
      <static>true</static>
      <pose>-3.0 -2.4 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col"><pose>0 0 0.73 0 0 0</pose><geometry><box><size>1.2 0.6 0.04</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.73 0 0 0</pose><geometry><box><size>1.2 0.6 0.04</size></box></geometry><material><ambient>0.65 0.45 0.25 1</ambient><diffuse>0.65 0.45 0.25 1</diffuse></material></visual>
        <collision name="leg0_col"><pose>-0.55 -0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg0_vis"><pose>-0.55 -0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg1_col"><pose>-0.55 0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg1_vis"><pose>-0.55 0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg2_col"><pose>0.55 -0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg2_vis"><pose>0.55 -0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg3_col"><pose>0.55 0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg3_vis"><pose>0.55 0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Chair: seat 0.4 x 0.4 m, backrest toward the aisle -->
    <model name="chair_left_1">
      <static>true</static>
      <pose>-2.0 -2.4 0 0 0 0</pose>
      <link name="link">
        <collision name="seat_col"><pose>0 0 0.43 0 0 0</pose><geometry><box><size>0.4 0.4 0.04</size></box></geometry></collision>
