        <collision name="leg_col"><pose>0 0 0.21 0 0 0</pose><geometry><box><size>0.06 0.06 0.42</size></box></geometry></collision>
        <visual name="leg_vis"><pose>0 0 0.21 0 0 0</pose><geometry><box><size>0.06 0.06 0.42</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Student desk 1.2 x 0.6 m, top at 0.75 m -->
    <model name="desk_right_3">
      <static>true</static>
      <pose>3.0 2.4 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col"><pose>0 0 0.73 0 0 0</pose><geometry><box><size>1.2 0.6 0.04</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.73 0 0 0</pose><geometry><box><size>1.2 0.6 0.04</size></box></geometry><material><ambient>0.65 0.45 0.25 1</ambient><diffuse>0.65 0.45 0.25 1</diffuse></material></visual>
        <collision name="leg0_col"><pose>-0.55 -0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg0_vis"><pose>-0.55 -0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg1_col"><pose>-0.55 0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg1_vis"><pose>-0.55 0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg2_col"><pose>0.55 -0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg2_vis"><pose>0.55 -0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg3_col"><pose>0.55 0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg3_vis"><pose>0.55 0.25 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Chair: seat 0.4 x 0.4 m, backrest toward the aisle -->
    <model name="chair_right_3">
      <static>true</static>
      <pose>2.0 2.4 0 0 0 0</pose>
      <link name="link">
        <collision name="seat_col"><pose>0 0 0.43 0 0 0</pose><geometry><box><size>0.4 0.4 0.04</size></box></geometry></collision>
        <visual name="seat_vis"><pose>0 0 0.43 0 0 0</pose><geometry><box><size>0.4 0.4 0.04</size></box></geometry><material><ambient>0.15 0.3 0.6 1</ambient><diffuse>0.15 0.3 0.6 1</diffuse></material></visual>
        <collision name="back_col"><pose>-0.18 0 0.65 0 0 0</pose><geometry><box><size>0.04 0.4 0.4</size></box></geometry></collision>
        <visual name="back_vis"><pose>-0.18 0 0.65 0 0 0</pose><geometry><box><size>0.04 0.4 0.4</size></box></geometry><material><ambient>0.15 0.3 0.6 1</ambient><diffuse>0.15 0.3 0.6 1</diffuse></material></visual>
        <collision name="leg_col"><pose>0 0 0.21 0 0 0</pose><geometry><box><size>0.06 0.06 0.42</size></box></geometry></collision>
        <visual name="leg_vis"><pose>0 0 0.21 0 0 0</pose><geometry><box><size>0.06 0.06 0.42</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Teacher desk near the whiteboard -->
    <model name="teacher_desk">
      <static>true</static>
      <pose>0 3.3 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col"><pose>0 0 0.73 0 0 0</pose><geometry><box><size>1.2 0.6 0.04</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.73 0 0 0</pose><geometry><box><size>1.2 0.6 0.04</size></box></geometry><material><ambient>0.65 0.45 0.25 1</ambient><diffuse>0.65 0.45 0.25 1</diffuse></material></visual>
        <collision name="body_col"><pose>0 0.2 0.355 0 0 0</pose><geometry><box><size>1.1 0.2 0.71</size></box></geometry></collision>
        <visual name="body_vis"><pose>0 0.2 0.355 0 0 0</pose><geometry><box><size>1.1 0.2 0.71</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Whiteboard mounted on the north wall (static, collidable) -->
    <model name="whiteboard">
      <static>true</static>
      <pose>0 3.9 1.4 0 0 0</pose>
      <link name="link">
        <collision name="board_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>2.5 0.05 1.2</size></box></geometry></collision>
        <visual name="board_vis"><pose>0 0 0 0 0 0</pose><geometry><box><size>2.5 0.05 1.2</size></box></geometry><material><ambient>0.97 0.97 0.97 1</ambient><diffuse>0.97 0.97 0.97 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= STATIC OBSTACLES ================= -->
    <!-- Bookshelf against the west wall -->
    <model name="bookshelf">
      <static>true</static>
      <pose>-4.7 -3.2 0.9 0 0 0</pose>
      <link name="link">
        <collision name="body_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 1.2 1.8</size></box></geometry></collision>
        <visual name="body_vis"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 1.2 1.8</size></box></geometry><material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Storage cabinet against the east wall -->
    <model name="cabinet">
      <static>true</static>
      <pose>4.65 3.3 0.9 0 0 0</pose>
      <link name="link">
        <collision name="body_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 1.0 1.8</size></box></geometry></collision>
        <visual name="body_vis"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.4 1.0 1.8</size></box></geometry><material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Cardboard box in the south-east corner -->
    <model name="storage_box">
      <static>true</static>
      <pose>4.3 -3.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="body_col"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="body_vis"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.6 0.6 0.5</size></box></geometry><material><ambient>0.8 0.6 0.2 1</ambient><diffuse>0.8 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Trash bin in the north-west corner -->
    <model name="trash_bin">
      <static>true</static>
      <pose>-4.3 3.4 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Round pillar in the central aisle: an obstacle-avoidance target -->
    <model name="pillar">
      <static>true</static>
      <pose>0.0 -2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.2</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Dynamic obstacle: physical cylinder driven by VelocityControl on /model/dynamic_obstacle/cmd_vel.
         Run scripts/patrol_obstacle.sh to make it move back and forth. -->
    <model name="dynamic_obstacle">
      <pose>-2 1.5 0.5 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>10</mass>
          <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>1 0.2 0.2 1</ambient>
            <diffuse>1 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    </model>

    <!-- Second dynamic obstacle: moves along the y axis (patrol_obstacle.sh drives it). -->
    <model name="dynamic_obstacle_2">
      <pose>1.5 -2 0.5 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>10</mass>
          <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.4 1 1</ambient>
            <diffuse>0.2 0.4 1 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    </model>
    

  </world>
</sdf>
