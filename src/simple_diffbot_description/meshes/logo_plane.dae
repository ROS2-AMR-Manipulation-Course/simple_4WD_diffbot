<?xml version="1.0" encoding="utf-8"?>
<!-- Unit 1x1 quad in the XZ plane, normal +Y, textured with the AI Farm Robotics logo.
     u runs toward -X so the logo reads correctly when viewed from +Y (robot's left side).
     Scale it in the URDF; yaw it by pi for the right side. -->
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_images>
    <image id="logo_img"><init_from>textures/ai_farm_logo.png</init_from></image>
  </library_images>
  <library_effects>
    <effect id="logo_fx">
      <profile_COMMON>
        <newparam sid="surf"><surface type="2D"><init_from>logo_img</init_from></surface></newparam>
        <newparam sid="samp"><sampler2D><source>surf</source></sampler2D></newparam>
        <technique sid="common">
          <lambert>
            <emission><color>0 0 0 1</color></emission>
            <ambient><texture texture="samp" texcoord="UVMap"/></ambient>
            <diffuse><texture texture="samp" texcoord="UVMap"/></diffuse>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="logo_mat"><instance_effect url="#logo_fx"/></material>
  </library_materials>
  <library_geometries>
    <geometry id="quad">
      <mesh>
        <source id="pos">
          <float_array id="pos_arr" count="12">
             0.5 0 -0.5
            -0.5 0 -0.5
            -0.5 0  0.5
             0.5 0  0.5
          </float_array>
          <technique_common>
            <accessor source="#pos_arr" count="4" stride="3">
              <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="nrm">
          <float_array id="nrm_arr" count="3">0 1 0</float_array>
          <technique_common>
            <accessor source="#nrm_arr" count="1" stride="3">
              <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="uv">
          <float_array id="uv_arr" count="8">0 0  1 0  1 1  0 1</float_array>
          <technique_common>
            <accessor source="#uv_arr" count="4" stride="2">
              <param name="S" type="float"/><param name="T" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="verts"><input semantic="POSITION" source="#pos"/></vertices>
        <triangles material="logo_mat" count="2">
          <input semantic="VERTEX" source="#verts" offset="0"/>
          <input semantic="NORMAL" source="#nrm" offset="1"/>
          <input semantic="TEXCOORD" source="#uv" offset="2" set="0"/>
          <p>0 0 0  1 0 1  2 0 2   0 0 0  2 0 2  3 0 3</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="scene">
      <node id="quad_node" name="quad_node">
        <instance_geometry url="#quad">
          <bind_material><technique_common>
            <instance_material symbol="logo_mat" target="#logo_mat"/>
          </technique_common></bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#scene"/></scene>
</COLLADA>
