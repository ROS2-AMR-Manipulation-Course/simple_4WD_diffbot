<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 2D LiDAR on top of the chassis (REP-103: X forward, Z up) -->
  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
    <xacro:cylinder_inertial m="0.15" r="0.035" h="0.04"/>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${laser_x} 0 ${chassis_center_z + chassis_height/2.0 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- IMU at the chassis centre -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
      <material name="sensor_green"/>
    </visual>
    <xacro:box_inertial m="0.01" x="0.02" y="0.02" z="0.01"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_center_z}" rpy="0 0 0"/>
  </joint>

  <!-- RGB camera at the front face of the chassis -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.06 0.03"/></geometry>
      <material name="sensor_dark"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.06 0.03"/></geometry>
    </collision>
    <xacro:box_inertial m="0.05" x="0.02" y="0.06" z="0.03"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2.0 + 0.01} 0 ${chassis_center_z + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame: Z forward, X right, Y down -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

</robot>
