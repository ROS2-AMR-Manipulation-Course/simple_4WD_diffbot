<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simple_diffbot_navigation</name>
  <version>0.0.0</version>
  <description>Nav2 bringup with selectable controller (pure pursuit, DWB, MPPI)</description>
  <maintainer email="yinchheanyun21@gmail.com">yunboyloy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_bringup</depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>simple_diffbot_localization</exec_depend>
  <exec_depend>simple_diffbot_slam</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
